# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017/portfolio
# Port for local development (ignored on Vercel)
PORT=5000
# Optional comma-separated list of origins allowed to call the API.
# Leave empty to allow all origins.
CORS_ORIGIN=http://localhost:3000
# Groq API key for the portfolio chat assistant (https://console.groq.com/keys).
# Without it, /api/chat returns 503 and the chat widget shows an offline message.
GROQ_API_KEY=
# Optional model override (defaults to openai/gpt-oss-120b)
GROQ_MODEL=
